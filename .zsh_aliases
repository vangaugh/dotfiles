#!/usr/bin/env sh

# CUSTOM ALIASES FOR MAC

# EASIER NAVIGATION: .., ..., ...., ....., ~ and -
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."
alias .....="cd ../../../.."
alias c="clear"
alias sss="source ~/.zshrc"

# SHORTCUTS
alias dl="cd ~/Downloads"
alias dt="cd ~/Desktop"
alias config='/opt/homebrew/bin/git --git-dir=$HOME/dotfiles/ --work-tree=$HOME'

# Change .wget-hsts file location
alias wget="wget --hsts-file ~/.local/wget-hsts"

# EZA Modern ls
if command -v eza >/dev/null 2>&1; then
  alias ls="eza --icons --group-directories-first --git"
  alias ll="eza -l --icons --group-directories-first --git"
  alias la="eza -la --icons --group-directories-first --git"
  alias lt="eza --tree --icons --git-ignore --level=2"
fi

# Enhanced cat
# alias cat="bat -n --paging=never"
# alias cat="bat --theme=\$(defaults read -globalDomain AppleInterfaceStyle &> /dev/null && echo default || echo GitHub)"

if command -v bat >/dev/null 2>&1; then
  alias cat="bat"
  alias batp="bat --style=numbers --paging=always"
fi

# Ripgrep search (faster than grep)
if command -v rg >/dev/null 2>&1; then
  alias grep="rg"
fi

# smarter cd using zoxide
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias z="zoxide"
  # quick jump with fuzzy interactive mode
  alias zi="zoxide query"
fi

# Ensure no alias conflicts
unalias gco 2>/dev/null
unalias ff 2>/dev/null
unalias frg 2>/dev/null

# Fuzzy find git branches
function gco {
  local branch
  branch=$(git branch --all | fzf | sed "s#remotes/origin/##;s#\* ##")
  [ -n "$branch" ] && git checkout "$branch"
}

# Fuzzy find files
function ff {
  fzf --preview="bat --style=numbers --color=always --line-range :300 {}"
}

# Search project with ripgrep + fzf
function frg {
  local res
  res=$(rg --color=always --line-number --no-heading --smart-case "${*:-}" | \
    fzf --ansi --delimiter ':' --preview 'bat --color=always {1} --highlight-line {2}')
  [ -n "$res" ] && ${EDITOR:-vim} "$(echo "$res" | cut -d: -f1)" +$(echo "$res" | cut -d: -f2)
}

# RUST BREACH SEARCH TOOL
# alias breach_search="clear && ~/Code/Work/python_projects/rust_search_tool/target/release/breach_search"

# ECHO PATH
alias path='echo -e ${PATH//:/\\n}'

# ENABLE ALIASES TO BE SUDO'D
alias sudo='sudo '

# FLUSH CACHE
alias flush="dscacheutil -flushcache && sudo killall -HUP mDNSResponder"

# CLEANUP LAUNCH SERVICES TO REMOVE DUPLICATES IN THE "OPEN WITH" MENU
alias lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -kill -r -domain local -domain system -domain user && killall Finder"

# Empty the Trash on all mounted volumes and the main HDD.
# Also, clear Apple’s System Logs to improve shell startup speed.
# Finally, clear download history from quarantine. https://mths.be/bum
alias jj="sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl; sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* 'delete from LSQuarantineEvent'"

# IP ADDRESS SHORTCUT
alias getip="curl http://ipecho.net/plain; echo"
alias localip="ipconfig getifaddr en1"

# UPDATE NPM--group-directories-first
alias npmup="npm update -g && npm install npm@latest -g"

# REPLACING CAT COMMAND WITH BAT
# alias cat="bat -n --paging=never"
# alias cat="bat --theme=\$(defaults read -globalDomain AppleInterfaceStyle &> /dev/null && echo default || echo GitHub)"

# DELETE .DS_Store FILES
alias ds="find . -type f \( -name ".DS_Store" -o -name "._.DS_Store" \) -delete -print 2>&1 | grep -v "Permission denied""
alias icic="find . -type f \( -name "Icon'$'\r'" -o -name "._Icon'$'\r'" \) -delete -print 2>&1 | grep -v "Permission denied""

# SHOW/HIDE HIDDEN FILES IN FINDER
alias show="defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder"
alias hide="defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder"

#LAUNCH ANDROID AVDMANAGER EMULATOR
alias androidvm="nohup emulator -avd my_android_36 -no-snapshot -no-boot-anim -camera-front webcam0 &"

# PYTHON VIRTUAL ENVIRONMENT
alias ve='python3 -m venv .venv && source .venv/bin/activate'
alias reqinstall='python3 -m pip install -r requirements.txt'

# UPDATE BREW && FULL SYSTEM UPDATE
alias brewup="brew update && brew upgrade && brew cleanup -s && brew autoremove && brew doctor"
alias brewfix='brew tap | while read tap; do repo="$(brew --repo $tap)"; git -C "$repo" reset --hard; git -C "$repo" clean -fd; git -C "$repo" checkout main 2>/dev/null || git -C "$repo" checkout master 2>/dev/null; git -C "$repo" pull; done'
alias brewdeep="brew update-reset && brew update && brew upgrade && brew cleanup -s && brew autoremove && brew doctor"
alias kk="sudo softwareupdate -i -a;"

# LAUNCH GOOGLE CHROME
alias chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome"

# Kill all the tabs in Chrome to free up memory
# [C] explained: http://www.commandlinefu.com/commands/view/402/exclude-grep-from-your-grepped-output-of-ps-alias-included-in-description
alias chromekill="ps ux | grep '[C]hrome Helper --type=renderer' | grep -v extension-process | tr -s ' ' | cut -d ' ' -f2 | xargs kill"

# Pipe my public key to my clipboard.
alias pbcopy="more ~/.ssh/id_vg-macmini.pub | pbcopy | echo '=> Public key copied to pasteboard.'"

# Git Function
function acp() {
  git add .
  git commit -m "$1"
  git push
}

# yazi — Fast TUI File Manager
alias yy="yazi"

## USEFUL COMMANDS

# SOFnTWARE PIRATING - WE TAKE
# sudo spctl --global-disable
# xattr -cr /path/to/installer/file

# OSINT SEARCHNG
alias search-un="bash ~/scripts/osint_recon/username_search.sh"
