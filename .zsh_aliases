#!/usr/bin/env zsh

#################################################
# BASIC NAVIGATION
#################################################

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias c='clear'
alias sss='source ~/.zshrc'

alias dl='cd ~/Downloads'
alias dt='cd ~/Desktop'

#################################################
# DOTFILES
#################################################

alias config='/opt/homebrew/bin/git --git-dir=$HOME/dotfiles/ --work-tree=$HOME'

#################################################
# TOOL IMPROVEMENTS
#################################################

# wget HSTS location
alias wget='wget --hsts-file ~/.local/wget-hsts'

# Modern ls
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons --group-directories-first --git'
  alias ll='eza -lh --icons --group-directories-first --git'
  alias la='eza -lah --icons --group-directories-first --git'
  alias lt='eza --tree --icons --git-ignore --level=2'
fi

# bat instead of cat
if command -v bat >/dev/null 2>&1; then
  alias cat='bat'
  alias batp='bat --style=numbers --paging=always'
fi

# ripgrep instead of grep
if command -v rg >/dev/null 2>&1; then
  alias grep='rg'
fi

#################################################
# SMART DIRECTORY JUMPING
#################################################

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
  alias z='zoxide'
  alias zi='zoxide query -i'
fi

#################################################
# FZF POWER TOOLS
#################################################

# fuzzy file picker
ff() {
  fzf --preview="bat --style=numbers --color=always --line-range :300 {}"
}

# ripgrep + fzf search
frg() {
  local result
  result=$(rg --color=always --line-number --no-heading --smart-case "$@" \
    | fzf --ansi --delimiter ':' \
      --preview 'bat --color=always {1} --highlight-line {2}')
  [ -n "$result" ] && ${EDITOR:-vim} "$(echo "$result" | cut -d: -f1)" +"$(echo "$result" | cut -d: -f2)"
}

#################################################
# GIT SHORTCUTS
#################################################

unalias gco 2>/dev/null

gco() {
  local branch
  branch=$(git branch --all | fzf | sed 's#remotes/origin/##;s#\* ##')
  [[ -n "$branch" ]] && git checkout "$branch"
}

acp() {
  git add .
  git commit -m "$1"
  git push
}

#################################################
# SYSTEM UTILITIES
#################################################

alias path='echo $PATH | tr ":" "\n"'

alias sudo='sudo '

alias flush='dscacheutil -flushcache && sudo killall -HUP mDNSResponder'

alias lscleanup="/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister \
-kill -r -domain local -domain system -domain user && killall Finder"

#################################################
# CLEANUP
#################################################

alias jj='
sudo rm -rfv /Volumes/*/.Trashes;
sudo rm -rfv ~/.Trash;
sudo rm -rfv /private/var/log/asl/*.asl;
sqlite3 ~/Library/Preferences/com.apple.LaunchServices.QuarantineEventsV* \
"delete from LSQuarantineEvent"
'

alias ds='find . -type f \( -name ".DS_Store" -o -name "._.DS_Store" \) -delete -print 2>&1 | grep -v "Permission denied"'

alias icic='find . -type f \( -name "Icon"$'\''\r'\'' -o -name "._Icon"$'\''\r'\'' \) -delete -print 2>&1 | grep -v "Permission denied"'

#################################################
# NETWORK
#################################################

myip() {
  echo "🌐 Network Information"
  echo "---------------------"

  printf "Local IP   : "
  ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1

  printf "Gateway    : "
  netstat -rn | awk '/default/ {print $2; exit}'

  printf "Public IP  : "
  curl -s https://api.ipify.org
  echo
}

#################################################
# NODE
#################################################

alias npmup='npm update -g && npm install npm@latest -g'

#################################################
# HOMEBREW
#################################################

alias brewup='brew update && brew upgrade && brew cleanup -s && brew autoremove && brew doctor'

brewfix() {
  brew tap | while read tap; do
    repo="$(brew --repo $tap)"
    git -C "$repo" reset --hard
    git -C "$repo" clean -fd
    git -C "$repo" checkout main 2>/dev/null || git -C "$repo" checkout master
    git -C "$repo" pull
  done
}

alias brewdeep='brew update-reset && brew update && brew upgrade && brew cleanup -s && brew autoremove && brew doctor'

alias kk='sudo softwareupdate -i -a'

#################################################
# APPLICATIONS
#################################################

alias chrome='/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome'
alias chromekill="pkill -f 'Chrome Helper --type=renderer'"

#################################################
# SSH
#################################################

copykey() {
  pbcopy < ~/.ssh/id_vg-macmini.pub
  echo "=> Public key copied to clipboard."
}

#################################################
# PYTHON
#################################################

alias ve='python3 -m venv .venv && source .venv/bin/activate'
alias reqinstall='python3 -m pip install -r requirements.txt'

#################################################
# ANDROID
#################################################

alias androidvm='nohup emulator -avd my_android_36 -no-snapshot -no-boot-anim -camera-front webcam0 &'

#################################################
# FILE MANAGER
#################################################

alias yy='yazi'

#################################################
# OSINT
#################################################

# Ex: searchall "John Smith" /
alias searchall='rg -uu --hidden --glob "!.git"'

alias search-un='bash ~/scripts/osint_recon/username_search.sh'
